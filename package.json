{
	"name": "personal-site",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "node scripts/assert-no-private-prerender.mjs --source && wrangler types && vite build && node scripts/wrap-worker-scheduled.mjs && node scripts/assert-no-private-prerender.mjs --output",
		"preview": "wrangler dev .svelte-kit/cloudflare/_worker.js --port 4173",
		"prepare": "svelte-kit sync && wrangler types || echo ''",
		"check": "wrangler types && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright install && playwright test",
		"gen": "wrangler types",
		"db:push": "drizzle-kit push",
		"auth:generate": "npx --yes @better-auth/cli@1.4.21 generate --config ./better-auth.config.ts --output ./src/lib/server/db/auth-schema.ts",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"db:apply": "wrangler d1 migrations apply personal-site --local",
		"access:grant": "node scripts/access.mjs grant",
		"access:revoke": "node scripts/access.mjs revoke",
		"access:list": "node scripts/access.mjs list",
		"backup": "node scripts/backup/run.mjs",
		"test:seed": "node scripts/seed-e2e-access.mjs",
		"test:seed:media": "node scripts/seed-e2e-media.mjs",
		"test:seed:content": "node scripts/seed-e2e-content.mjs",
		"media:fixtures": "node scripts/media/fixtures.mjs",
		"media:publish": "node scripts/media/publish.mjs",
		"content:fixtures": "node scripts/content/fixtures.mjs",
		"content:publish": "node scripts/content/publish.mjs",
		"publish": "node scripts/content/publish.mjs"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-cloudflare": "^7.2.8",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/node": "^24",
		"@vitest/browser-playwright": "^4.1.8",
		"blurhash": "^2.0.5",
		"drizzle-kit": "^0.31.10",
		"drizzle-orm": "^0.45.2",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"ffmpeg-static": "^5.3.0",
		"ffprobe-static": "^3.1.0",
		"globals": "^17.6.0",
		"miniflare": "5.20260801.1-alpha",
		"piexifjs": "^1.0.6",
		"playwright": "^1.60.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"sharp": "^0.35.3",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.0.16",
		"vitest": "^4.1.8",
		"vitest-browser-svelte": "^2.1.1",
		"wrangler": "^4.97.0"
	},
	"dependencies": {
		"better-auth": "1.6.26"
	}
}
